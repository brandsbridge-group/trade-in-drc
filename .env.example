# Trade in DRC — environment variables
#
# Copy to `.env` and fill in. `.env` is git-ignored; only this example is tracked.
# These are every variable the code actually reads. If you add a new one, add it
# here too, or the next person to clone the repo cannot start the app.
#
# In production these live in the Vercel project's environment variables, not in a
# file. NEXT_PUBLIC_* values are exposed to the browser by Next.js — never put a
# secret behind that prefix.

# ── Supabase (required) ───────────────────────────────────────────────────────
# Project URL and anon key: Supabase dashboard → Project Settings → API.
# The anon key is public by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: bypasses RLS. SERVER-ONLY — it is read solely by
# src/lib/supabase/admin.ts and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site URL (required in production) ─────────────────────────────────────────
# Canonical origin, used for sitemap, robots, metadataBase, hreflang and the
# post-signup email redirect. Falls back to the DEFAULT_SITE_URL in
# src/app/sitemap.ts when unset. Set this to the real domain once one exists.
# E-mails have NO fallback in production (src/lib/site-url.ts): without it the
# newsletter refuses to send rather than mail links that lead nowhere.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudflare Turnstile (required for messaging and opportunity submissions) ──
# Dashboard → Turnstile → add a site. Note: if CAPTCHA_SECRET_KEY is unset,
# verification fails OPEN, so leaving it blank disables abuse protection.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ── Direct messaging between buyers and companies (off by default) ────────────
# Off: the inbox, the "message the supplier" buttons and the replies to a
# notice are hidden and refused by the server (src/config/features.ts); every
# contact goes through the team. Set to true to bring them back. Read at build
# time: changing it needs a rebuild.
NEXT_PUBLIC_MESSAGING_ENABLED=

# ── Image seeding (optional, local only) ──────────────────────────────────────
# Only needed to run `npm run seed:images`. The app itself does not use these.
# Rate limits: Unsplash 50 req/hour, Pexels 200 req/hour.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── E-mail (optional — Resend) ────────────────────────────────────────────────
# Every e-mail the app sends goes through src/lib/email/send.ts: the "we
# received your request" and event receipts (transactional), and the newsletter.
# When the key or the sender is missing nothing is sent, and the screens say so
# honestly instead of promising an e-mail.
# Senders must be on a domain verified in Resend, e.g.
#   EMAIL_FROM=TradeInDRC <notifications@tradeindrc.com>
# NEWSLETTER_FROM_EMAIL is the sender of newsletter e-mails; each of the two
# falls back to the other, so one is enough.
RESEND_API_KEY=
EMAIL_FROM=
NEWSLETTER_FROM_EMAIL=

# ── Newsletter ────────────────────────────────────────────────────────────────
# Key that signs unsubscribe links (any long random string). Optional: the
# service-role key is used when unset. Changing either one invalidates the
# unsubscribe link of every e-mail already sent.
NEWSLETTER_TOKEN_SECRET=
# Lets a scheduler call /api/cron/newsletter (Authorization: Bearer <value>) to
# finish campaigns whose console tab was closed mid-send. Without it the route
# is off and campaigns only advance while a super-admin has the console open.
CRON_SECRET=

# ── Not configured ────────────────────────────────────────────────────────────
# Account email (signup confirmation, password reset) is sent by Supabase Auth,
# not by the app. A registration confirmation email is an open item — see
# docs/handover/REGISTRATION-FIXES.md §12.
#
# There is no payment provider. Premium plans are sold offline and granted by an
# admin in /admin/requests/premium.
