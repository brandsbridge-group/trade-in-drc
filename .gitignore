# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.mcp.json
.superpowers/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node-compile-cache
supabase/.temp/
.gstack/

# agent/workflow scratch (worktrees, generated workflow scripts, one-shot SQL dumps)
/attr-*/
docs/superpowers/audit/wf-*.js
docs/superpowers/audit/i18n-fragments/
supabase/apply_new_migrations_*.sql

# Large design source binaries (kept on disk, not in git)
latest-designs/*.ai
